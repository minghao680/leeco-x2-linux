# Keep text files LF so kernel patches and CI `git apply` work on Linux.
* text=auto
*.patch text eol=lf
*.dts text eol=lf
*.dtsi text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.config text eol=lf
*.aarch64 text eol=lf
*.fragment text eol=lf

# Binary assets must never be line-ending converted.
*.bin binary
*.img binary
*.gz binary
*.xz binary
*.zip binary
*.png binary
*.jpg binary
