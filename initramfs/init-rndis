#!/bin/sh
# x2 mainline initramfs: RNDIS network + ACM rescue console.
# Goal: bring up a USB network link so a Debian rootfs can be pushed into RAM
# without touching any Android partition.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

busybox mount -t proc  none /proc  2>/dev/null
busybox mount -t sysfs none /sys   2>/dev/null
busybox mount -t devtmpfs none /dev 2>/dev/null || busybox mdev -s

echo
echo "=== x2 mainline initramfs (rndis+acm) ==="
cat /proc/version

# Keep console on the physical UART if it exists (it does not on x2).
if [ -c /dev/ttyMSM0 ]; then
	exec </dev/ttyMSM0 >/dev/ttyMSM0 2>&1
fi

busybox mkdir -p /sys/kernel/config 2>/dev/null
busybox mount -t configfs none /sys/kernel/config 2>/dev/null

G=/sys/kernel/config/usb_gadget/g1
busybox mkdir -p "$G" 2>/dev/null
if [ -d "$G" ]; then
	(
	cd "$G" || exit 0
	echo 0x0525 > idVendor
	echo 0xa4a7 > idProduct
	busybox mkdir -p strings/0x409
	echo "leeco" > strings/0x409/manufacturer
	echo "x2" > strings/0x409/product
	echo "x2mainline" > strings/0x409/serialnumber
	busybox mkdir -p configs/c.1/strings/0x409
	echo "rndis+acm" > configs/c.1/strings/0x409/configuration

	# RNDIS must be the first function for the Windows RNDIS driver.
	busybox mkdir -p functions/rndis.usb0
	echo usb0 > functions/rndis.usb0/ifname
	echo 02:11:22:33:44:55 > functions/rndis.usb0/dev_addr
	echo 02:11:22:33:44:66 > functions/rndis.usb0/host_addr
	busybox mkdir -p functions/acm.usb0
	busybox ln -s functions/rndis.usb0 configs/c.1/ 2>/dev/null
	busybox ln -s functions/acm.usb0 configs/c.1/ 2>/dev/null
	UDC=$(busybox ls /sys/class/udc 2>/dev/null | busybox head -1)
	if [ -n "$UDC" ]; then
		echo "$UDC" > UDC && echo "[init] gadget bound to $UDC"
	else
		echo "[init] no UDC found"
	fi
	)
fi

# Bring the RNDIS netdev up and give the host a DHCP lease.
busybox ip link set usb0 up 2>/dev/null
busybox ip addr add 192.168.42.1/24 dev usb0 2>/dev/null
busybox mkdir -p /etc
cat > /etc/udhcpd.conf <<'EOF'
start	192.168.42.10
end	192.168.42.20
interface	usb0
option	subnet	255.255.255.0
option	router	192.168.42.1
option	dns	192.168.42.1
EOF
busybox udhcpd /etc/udhcpd.conf 2>/dev/null && echo "[init] udhcpd started"

echo "[init] net:"; busybox ip addr show usb0 2>/dev/null
echo "[init] block devices:"; busybox ls /dev/sd* 2>/dev/null | busybox head
echo "[init] mem:"; busybox free

# Rescue shell on the ACM port, respawned if it dies.
for c in /dev/ttyGS0 /dev/ttyMSM0 /dev/console; do
	[ -c "$c" ] && {
		echo "[init] shell on $c"
		busybox setsid sh -c "busybox stty sane 2>/dev/null; while :; do sh -i; done" <"$c" >"$c" 2>&1 &
	}
done

echo "=== x2 shell ready (rndis+acm) ==="
while :; do sleep 1; done
