#!/bin/sh
# x2 mainline initramfs -> Debian 13, entirely in RAM.
#
# The Debian rootfs tarball is carried inside this initramfs (/rootfs.tar.xz), so
# nothing has to travel over the flaky USB ACM link and no partition is written.
# We unpack it into a tmpfs and chroot into it.  PID1 never leaves the
# initramfs, so a crashed Debian shell cannot panic the kernel.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

busybox mount -t proc  none /proc  2>/dev/null
busybox mount -t sysfs none /sys   2>/dev/null
busybox mount -t devtmpfs none /dev 2>/dev/null || busybox mdev -s
busybox mkdir -p /sys/kernel/config 2>/dev/null
busybox mount -t configfs none /sys/kernel/config 2>/dev/null

echo
echo "=== x2 mainline -> Debian 13 (RAM) ==="
cat /proc/version
busybox free

# ---- USB ACM console -------------------------------------------------------
G=/sys/kernel/config/usb_gadget/g1
busybox mkdir -p "$G" 2>/dev/null
(
cd "$G" || exit 0
echo 0x0525 > idVendor
echo 0xa4a7 > idProduct
busybox mkdir -p strings/0x409
echo "leeco" > strings/0x409/manufacturer
echo "x2"    > strings/0x409/product
echo "x2debian" > strings/0x409/serialnumber
busybox mkdir -p configs/c.1/strings/0x409
echo "serial" > configs/c.1/strings/0x409/configuration
busybox mkdir -p functions/acm.usb0
busybox ln -s functions/acm.usb0 configs/c.1/ 2>/dev/null
UDC=$(busybox ls /sys/class/udc 2>/dev/null | busybox head -1)
if [ -n "$UDC" ]; then echo "$UDC" > UDC && echo "[init] gadget bound to $UDC"; fi
)
i=0
while [ ! -c /dev/ttyGS0 ] && [ $i -lt 20 ]; do busybox sleep 1; i=$((i+1)); done
echo "[init] waited ${i}s for /dev/ttyGS0"

# Fallback shell in the initramfs, used for rescue if Debian cannot start.
rescue() {
	echo "[init] entering RESCUE initramfs shell on ttyGS0"
	busybox setsid sh -c 'busybox stty sane 2>/dev/null; while :; do sh -i; done' \
		</dev/ttyGS0 >/dev/ttyGS0 2>&1 &
	while :; do busybox sleep 1; done
}

# ---- Unpack the Debian rootfs into RAM -------------------------------------
busybox mkdir -p /newroot
if ! busybox mount -t tmpfs -o size=1600M tmpfs /newroot 2>/dev/null; then
	busybox mount -t tmpfs tmpfs /newroot || { echo "[init] tmpfs failed"; rescue; }
fi

if [ ! -f /rootfs.tar.xz ]; then
	echo "[init] FATAL: /rootfs.tar.xz missing"
	rescue
fi

echo "[init] unpacking Debian rootfs (417 MB), please wait..."
( busybox xz -dc /rootfs.tar.xz | busybox tar -xf - -C /newroot ) &
pid=$!
while kill -0 $pid 2>/dev/null; do
	echo -n "."
	busybox sleep 5
done
wait $pid
rc=$?
echo
if [ $rc -ne 0 ] || [ ! -x /newroot/usr/bin/bash ]; then
	echo "[init] unpack failed rc=$rc"
	busybox ls /newroot | busybox head -20
	rescue
fi
echo "[init] rootfs ready"
busybox ls /newroot
busybox cat /newroot/etc/debian_version 2>/dev/null

# ---- Pseudo filesystems inside the new root --------------------------------
for d in proc sys dev dev/pts tmp run; do busybox mkdir -p /newroot/$d; done
busybox mount --bind /dev  /newroot/dev  2>/dev/null
busybox mount --bind /proc /newroot/proc 2>/dev/null
busybox mount --bind /sys  /newroot/sys  2>/dev/null
busybox mount -t devpts devpts /newroot/dev/pts 2>/dev/null

# The LXC image ships with a locked root account; unlock it for console use.
busybox sed -i 's|^root:[^:]*:|root::|' /newroot/etc/shadow 2>/dev/null
busybox cp /etc/resolv.conf /newroot/etc/resolv.conf 2>/dev/null

# cd into the new root first so the inherited cwd stays valid after chroot.
cd /newroot || rescue

echo "=== entering Debian 13 userspace ==="
echo "[init] 'exit' drops you back here; the shell respawns, PID1 stays in initramfs"

# ---- Interactive Debian shell, respawned forever ---------------------------
while :; do
	busybox chroot /newroot /usr/bin/env -i \
		HOME=/root TERM=vt100 \
		PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
		/bin/bash -i </dev/ttyGS0 >/dev/ttyGS0 2>&1
	echo "[init] Debian shell exited (rc=$?); respawning in 2s"
	busybox sleep 2
done
