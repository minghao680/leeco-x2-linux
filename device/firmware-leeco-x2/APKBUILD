# LeEco Le Max 2 (x2) firmware - SKELETON
#
# The mainline remoteproc drivers for msm8996 load the modem/DSP firmware
# from /lib/firmware/qcom/msm8996/. The blobs must be dumped from the
# device (they are not redistributable from any package repo):
#
#   mba.mbn   <- modem partition (offset 0)
#   modem.mbn <- modem partition
#   adsp.mbn  <- dsp partition
#   slpi.mbn  <- dsp partition (sensor island; optional for first boot)
#
# To populate this package:
#   1. dd the modem/dsp partitions from the running Android (backup/ dir
#      already holds the dumps)
#   2. extract the single .mbn images (they are concatenated images; use
#       the offsets from the stock DTS modem-bringing-up notes)
#   3. put the files next to this APKBUILD, add them to source=, run
#      `abuild checksum` and install them in package() under
#      /lib/firmware/qcom/msm8996/
#
# Everything else needed for a first working system comes from the shared
# firmware packages the device package already depends on:
#   WiFi  qca6174   -> linux-firmware-ath10k
#   BT    qca Rome  -> linux-firmware-qca
#   GPU   Adreno530 -> linux-firmware-qcom
#   Video venus 4.2  -> linux-firmware-qcom

pkgname=firmware-leeco-x2
pkgver=1
pkgrel=0
pkgdesc="LeEco Le Max 2 firmware (modem/DSP - not yet populated)"
url="https://github.com/minghao680/leeco-x2-nura"
arch="aarch64"
license="proprietary"
options="!strip !check !archcheck"
source=""

package() {
	# Placeholder until the blobs are dumped from the device; keeps the
	# device package dependency resolvable so pmbootstrap can build a
	# bootable (modem-less) image.
	mkdir -p "$pkgdir/lib/firmware/qcom/msm8996"
}
