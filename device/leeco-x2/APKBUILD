# LeEco Le Max 2 (x2 / LEX820) - Nura device package
#
# Boot flow: lk2nd (boot partition) -> extlinux.conf on the rootfs ->
# linux-postmarketos-qcom-msm8996 with the x2 DTS/panel patches injected
# by the CI (see scripts/pmaports-inject.py and kernel/pmaports/).

pkgname=device-leeco-x2
pkgdesc="LeEco Le Max 2"
pkgver=0.2
pkgrel=0
url="https://github.com/minghao680/leeco-x2-nura"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bootmac
	firmware-leeco-x2
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	mesa-egl
	msm-modem
	postmarketos-base
	soc-qcom-msm8996
	soc-qcom-msm8996-ucm
	"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-kernel-extlinux:kernel_extlinux
	$pkgname-openrc
	"
source="
	deviceinfo
	modules-initfs
	kernel-cmdline.conf
	30-gpu-firmware.files
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/30-gpu-firmware.files" \
		-t "$pkgdir/usr/share/mkinitfs/files"
}

kernel_extlinux() {
	pkgdesc="Use lk2nd to boot via extlinux.conf"
	depends="linux-postmarketos-qcom-msm8996"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

openrc() {
	default_openrc

	mkdir "$subpkgdir"
}
