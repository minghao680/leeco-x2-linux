# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="LeEco Le Max 2"
deviceinfo_manufacturer="LeEco"
deviceinfo_codename="leeco-x2"
deviceinfo_year="2016"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_drm="true"
deviceinfo_chassis="handset"
deviceinfo_screen_width="1440"
deviceinfo_screen_height="2560"
deviceinfo_rootfs_image_sector_size="4096"

# Bootloader related
# lk2nd lives in the boot partition and boots kernel/dtb/initramfs straight
# from the rootfs via /extlinux/extlinux.conf - kernel updates go through
# apk and never touch the boot partition. fastboot is only used once, for
# the initial rootfs flash to userdata.
deviceinfo_flash_method="fastboot"
deviceinfo_flash_sparse="true"

# extlinux.conf (lk2nd)
deviceinfo_dtb_extlinux="qcom/msm8996-leeco-x2"
deviceinfo_generate_extlinux_config_extlinux="true"
deviceinfo_boot_filesystem_extlinux="ext2"
