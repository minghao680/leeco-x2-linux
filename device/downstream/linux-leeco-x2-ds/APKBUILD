# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/lineage_x2_defconfig
# (the Le Max 2's own LineageOS defconfig, + pmOS additions at the end)

pkgname=linux-leeco-x2-ds
pkgver=3.18.140
pkgrel=0
pkgdesc="LeEco Le Max 2 downstream kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="leeco-x2-ds"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	dtbtool
	devicepkg-dev
	flex
	openssl-dev
	perl
"

# Source
_repository="android_kernel_leeco_msm8996"
_commit="d90c4da00221a7f3db81be68ff1ae52a3558a789"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	gcc10-extern_YYLOC_global_declaration.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		CONFIG_NO_ERROR_ON_MISMATCH=y \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"

	# QCDT blob for the stock aboot (33 DTBs, selected at runtime by
	# qcom,msm-id / qcom,board-id - same mechanism as the stock boot.img)
	dtbTool -s 2048 -p "$builddir/$_outdir/scripts/dtc/" \
		-o "$builddir/$_outdir/arch/arm64/boot/dt.img" \
		"$builddir/$_outdir/arch/arm64/boot/dts/"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" "$_flavor" "$_outdir"
}

