[Unit]
Description=X2 GNOME Wayland session on tty1
After=systemd-user-sessions.service
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
Group=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/x2-gnome-session
Restart=no
TimeoutStartSec=0

[Install]
WantedBy=graphical.target
