Subject: [PATCH] a530: restore original submit error handling for logical rpm

--- a/drivers/gpu/drm/msm/msm_gpu.c
+++ b/drivers/gpu/drm/msm/msm_gpu.c
@@ -951,27 +951,11 @@
 {
 	struct msm_ringbuffer *ring = submit->ring;
 	unsigned long flags;
-	int ret;
 
 	WARN_ON(!mutex_is_locked(&gpu->lock));
 
-	ret = pm_runtime_get_sync(&gpu->pdev->dev);
-	if (ret < 0) {
-		dev_err(gpu->dev->dev,
-			"msm_gpu_submit: runtime resume failed: %d\n", ret);
-		return;
-	}
-
-	ret = msm_gpu_hw_init(gpu);
-	if (ret) {
-		dev_err(gpu->dev->dev,
-			"msm_gpu_submit: hw_init failed: %d, skipping frame\n",
-			ret);
-		dma_fence_set_error(submit->hw_fence, ret);
-		dma_fence_signal(submit->hw_fence);
-		pm_runtime_put(&gpu->pdev->dev);
-		return;
-	}
+	pm_runtime_get_sync(&gpu->pdev->dev);
+	msm_gpu_hw_init(gpu);
 
 	submit->seqno = submit->hw_fence->seqno;
 
