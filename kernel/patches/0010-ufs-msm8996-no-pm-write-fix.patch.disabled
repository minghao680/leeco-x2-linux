diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -1165,6 +1165,17 @@ static void ufs_qcom_set_caps(struct ufs_hba *hba)
 	hba->caps |= UFSHCD_CAP_AGGR_POWER_COLLAPSE;
 	hba->caps |= UFSHCD_CAP_RPM_AUTOSUSPEND;
 
+	/* LeEco x2 (msm8996 UFS 2.0): PM transitions on this controller/PHY
+	 * cause DL_TCx_REPLAY errors and OCS-invalid aborts on sustained writes.
+	 * Keep the link and clocks active until the vendor quirks are ported. */
+	if (of_device_is_compatible(hba->dev->of_node, "qcom,msm8996-ufshc"))
+		hba->caps &= ~(UFSHCD_CAP_CLK_GATING |
+			       UFSHCD_CAP_HIBERN8_WITH_CLK_GATING |
+			       UFSHCD_CAP_CLK_SCALING |
+			       UFSHCD_CAP_WB_WITH_CLK_SCALING |
+			       UFSHCD_CAP_AGGR_POWER_COLLAPSE |
+			       UFSHCD_CAP_RPM_AUTOSUSPEND);
+
 	ufs_qcom_set_host_caps(hba);
 }
 
