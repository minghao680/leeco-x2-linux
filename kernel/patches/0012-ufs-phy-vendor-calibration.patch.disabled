 static const struct qmp_phy_init_tbl sc7280_ufsphy_tx[] = {
@@ -1115,6 +1132,9 @@ struct qmp_phy_cfg {
 
 	/* true, if PCS block has no separate SW_RESET register */
 	bool no_pcs_sw_reset;
+
+	/* Apply the 14nm PHY SVS configuration after PCS becomes ready */
+	bool svs_mode;
 };
 
 struct qmp_ufs {
@@ -1271,6 +1291,8 @@ static const struct qmp_phy_cfg msm8996_ufsphy_cfg = {
 		.tx_num		= ARRAY_SIZE(msm8996_ufsphy_tx),
 		.rx		= msm8996_ufsphy_rx,
 		.rx_num		= ARRAY_SIZE(msm8996_ufsphy_rx),
