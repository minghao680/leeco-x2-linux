+/* the second DSI interface that a split display pair drives */
+static struct mdp5_interface *mdp5_split_intf(struct mdp5_kms *mdp5_kms,
+					      struct mdp5_interface *intf)
+{
+	int i;
+
+	if (!mdp5_kms->dual_dsi_split)
+		return NULL;
+
+	for (i = 0; i < mdp5_kms->num_intfs; i++) {
+		struct mdp5_interface *cur = mdp5_kms->intfs[i];
+
+		if (cur == intf || cur->type != INTF_DSI)
+			continue;
+		return cur;
+	}
+
+	return NULL;
+}
