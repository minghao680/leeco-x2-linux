+/* the pipeline an encoder feeds: left by default, right for split display */
+struct mdp5_pipeline *mdp5_crtc_get_pipeline_for(struct drm_crtc *crtc,
+						  struct mdp5_interface *intf)
+{
+	struct mdp5_crtc_state *mdp5_cstate;
+
+	if (WARN_ON(!crtc))
+		return ERR_PTR(-EINVAL);
+
+	mdp5_cstate = to_mdp5_crtc_state(crtc->state);
+
+	if (mdp5_cstate->pipeline.dual_intf &&
+	    mdp5_cstate->pipeline_r.intf == intf)
+		return &mdp5_cstate->pipeline_r;
+
+	return &mdp5_cstate->pipeline;
+}
